PORT=3000
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/crypto_upgrade
# Для продакшена: токен бота из @BotFather (проверка подписи Telegram Mini App).
TELEGRAM_BOT_TOKEN=
# true только для локального теста в браузере (вход без Telegram + тестовое пополнение). В продакшене ОБЯЗАТЕЛЬНО false.
DEV_MODE=true

# --- Импорт скинов из Steam (npm run import:steam) ---
# 5 = российский рубль
STEAM_CURRENCY=5
# Минимальная цена скина в копейках. 1 = все скины, у которых есть цена. (400 = только от 4 ₽)
MIN_PRICE_KOPEKS=1
# Пауза между запросами к Steam, мс (Steam быстро банит за частые запросы)
STEAM_IMPORT_DELAY_MS=3500
